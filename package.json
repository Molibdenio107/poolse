{
  "name": "poolse",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "i18n:check": "pnpm --filter @poolse/web i18n:check",
    "contrast:check": "pnpm --filter @poolse/web contrast:check",
    "pt:check": "pnpm --filter @poolse/web pt:check",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate",
    "db:psql": "docker compose exec postgres psql -U postgres -d poolse_dev",
    "db:bootstrap": "pnpm --filter @poolse/db bootstrap",
    "db:platform-admin": "pnpm --filter @poolse/db platform-admin",
    "db:migrate": "pnpm --filter @poolse/db migrate",
    "db:seed": "pnpm --filter @poolse/db seed",
    "db:test": "pnpm --filter @poolse/db test",
    "api:test": "pnpm --filter @poolse/api test",
    "web:test": "pnpm --filter @poolse/web test",
    "e2e": "pnpm --filter @poolse/web e2e",
    "layout:check": "pnpm --filter @poolse/web layout:check",
    "sql:check": "pnpm --filter @poolse/api sql:check",
    "csv:check": "pnpm --filter @poolse/web csv:check",
    "forms:check": "pnpm --filter @poolse/web forms:check",
    "audit:check": "pnpm audit --audit-level high",
    "security:check": "pnpm sql:check && pnpm csv:check && pnpm audit:check"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "ajv@^8": ">=8.18.0",
      "body-parser": ">=1.20.6",
      "glob@^10": ">=10.5.0",
      "js-yaml@^4": ">=4.3.2",
      "multer": ">=2.4.0",
      "picomatch@^4": ">=4.0.4",
      "postcss": ">=8.5.23",
      "qs": ">=6.16.0",
      "sharp": ">=0.35.5",
      "tmp": ">=0.2.6",
      "webpack": ">=5.104.1",
      "proxy-addr": ">=2.0.8",
      "fast-xml-parser@^4": ">=4.5.5 <5",
      "fast-uri@^3": ">=3.1.8 <4",
      "source-map-js": ">=1.2.2",
      "brace-expansion@^1": ">=1.1.21 <2",
      "brace-expansion@^2": ">=2.1.7 <3",
      "brace-expansion@^5": ">=5.0.12 <6"
    }
  }
}
