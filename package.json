{
  "name": "poolse",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @poolse/db migrate",
    "db:test": "pnpm --filter @poolse/db test"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
