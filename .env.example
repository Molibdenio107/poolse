# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Migrations run as the OWNER (bypasses RLS by design).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolse_dev

# The API connects as the unprivileged app role, which RLS applies to.
# These must be different roles or tenant isolation does nothing.
DATABASE_APP_URL=postgresql://poolse_app:change-me@localhost:5432/poolse_dev

# --- Clerk ------------------------------------------------------------------
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- API --------------------------------------------------------------------
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Deploy -----------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
