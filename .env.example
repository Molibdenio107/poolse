# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Migrations run as the OWNER (bypasses RLS by design).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poolse_dev

# The API connects as the unprivileged app role, which RLS applies to.
# These must be different roles or tenant isolation does nothing.
DATABASE_APP_URL=postgresql://poolse_app:change-me@localhost:5432/poolse_dev

# --- Clerk ------------------------------------------------------------------
# Dashboard → API keys.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Dashboard → Webhooks → your endpoint → Signing Secret (whsec_…).
# The API refuses to start without it: an unverified webhook endpoint is an
# unauthenticated write path into app_user.
CLERK_WEBHOOK_SIGNING_SECRET=

# Where Clerk sends people after sign-in / sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to land when there is no return URL to honour. Most people arriving at
# sign-up came from an invitation link and Clerk sends them back to it; this is
# the fallback for everyone else, and the landing page is not it.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- API --------------------------------------------------------------------
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origins allowed to present a Clerk session token to the API (comma-separated).
# Defaults to WEB_ORIGIN. Without it, a token minted for any other app on the
# same Clerk instance would authenticate here.
WEB_ORIGIN=http://localhost:3000
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- Email --------------------------------------------------------------------
# Transactional email. `console` logs the message instead of sending it, which is
# the right default locally: the invitation link is on screen anyway, so the flow
# works end to end with nothing configured.
#
# To actually send, set EMAIL_PROVIDER=resend and add a key from resend.com.
# A fresh Resend account can send from onboarding@resend.dev to the address that
# owns the account without verifying a domain — enough to test the whole flow.
# Sending to anyone else needs your own domain verified, and then EMAIL_FROM
# becomes something like "Poolse <convites@poolse.pt>".
# Leave this as `console` and invitations log the message instead of sending it,
# which is what local development wants. Set it to `resend` with a key below and
# invitations actually arrive — there is no other switch, and no code change.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Poolse <onboarding@resend.dev>

# --- Sensitive data -----------------------------------------------------------
# Medical notes are encrypted with AES-256-GCM before they are stored, so the
# database only ever holds ciphertext. Base64 of 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Lose this and the existing medical notes become unreadable — there is no
# recovery path, by design. Staging and production get their own, different keys.
SENSITIVE_DATA_KEY=

# --- Deploy -----------------------------------------------------------------
NODE_ENV=development
APP_ENV=local

# --- Weather (backlog round 3, story 3) ---------------------------------------
# Open-Meteo needs no key on the free tier, so these are all optional and the
# defaults work. They exist from the first commit because the free tier is
# NON-COMMERCIAL USE ONLY: the day Poolse has a paying customer, a commercial
# licence is required, and switching should be setting two variables rather than
# editing code.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_API_KEY=
