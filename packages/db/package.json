{
  "name": "@poolse/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts up",
    "migrate:deployed": "node dist/migrate.js up",
    "bootstrap": "node --env-file-if-exists=../../.env --import tsx src/bootstrap-role.ts",
    "bootstrap:deployed": "node dist/bootstrap-role.js",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "migrate:down": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts down",
    "test": "node --env-file-if-exists=../../.env --import tsx src/run-sql-test.ts test/tenant-isolation.sql test/clerk-provisioning.sql test/invitations.sql test/preferences.sql test/profile.sql test/audit-log.sql test/facilities.sql test/students.sql test/consent.sql test/ownership.sql test/progression.sql test/classes.sql test/sessions.sql test/attendance.sql test/vacations.sql test/seasons.sql test/person.sql"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
